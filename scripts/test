#!/usr/bin/env bash
# Lint and test the integration in an isolated uv environment.
# Usage: scripts/test [pytest args]   e.g. scripts/test -k config_flow -v
# Needs uv. Installs nothing globally.
set -euo pipefail
cd "$(dirname "$0")/.."
uvx ruff@0.14.0 check custom_components tests
uvx ruff@0.14.0 format --check custom_components tests
uv run --no-project --python 3.14 --with-requirements requirements_test.txt pytest "$@"
